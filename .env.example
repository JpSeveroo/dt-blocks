# Ambiente de execução (development | production)
APP_ENV=development

# Backend (Processo FastAPI - 1 worker)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SQLITE_DB_PATH=./data/dtblocks.db

# Parâmetros de Arquitetura (DT-Blocks 2.0)
MAX_PARTICIPANTS_PER_SESSION=5
FIELD_LOCK_LEASE_SECONDS=30
BATCH_FLUSH_INTERVAL_MS=1500

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
